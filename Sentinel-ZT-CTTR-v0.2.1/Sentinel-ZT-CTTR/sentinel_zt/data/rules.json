  {
    "id": "B004",
    "title": "Agent 未授权高权限工具调用",
    "score": 65,
    "stage": "execution",
    "attack": [
      "T1059"
    ],
    "condition": {
      "all": [
        {
          "field": "event_type",
          "op": "eq",
          "value": "agent"
        },
        {
          "field": "tool",
          "op": "in",
          "value": [
            "shell",
            "exec",
            "read_secret",
            "network_admin"
          ]
        },
        {
          "field": "authorized",
          "op": "eq",
          "value": false
        }
      ]
    },
    "rationale": "必须由可信工具网关提供授权判定；提示词文本本身不作为执行证据。",
    "false_positives": "接入器字段映射错误。",
    "status": "experimental"
  },
  {
    "id": "B005",
    "title": "异常读取密钥或工作负载令牌",
    "score": 60,
    "stage": "credential_access",
    "attack": [
      "T1552.001"
    ],
    "condition": {
      "all": [
        {
          "field": "event_type",
          "op": "eq",
          "value": "file_read"
        },
        {
          "field": "authorized",
          "op": "eq",
          "value": false
        },
        {
          "field": "file_path",
          "op": "contains_any",
          "value": [
            "/.ssh/",
            "/secrets/",
            "/serviceaccount/token",
            "/.aws/credentials"
          ]
        }
      ]
    },
    "rationale": "明确的未授权读取与敏感文件路径同时出现。",
    "false_positives": "被错误标记的备份或安全审计。",
    "status": "experimental"
  },
  {
    "id": "B006",
    "title": "管理接口未认证且返回成功状态",
    "score": 55,
    "stage": "initial_access",
    "attack": [
      "T1190"
    ],
    "condition": {
      "all": [
        {
          "field": "event_type",
          "op": "eq",
          "value": "http"
        },
        {
          "field": "authenticated",
          "op": "eq",
          "value": false
        },
        {
          "field": "status",
          "op": "in",
          "value": [
            200,
            201,
            204
          ]
        },
        {
          "any": [
            {
              "field": "path_normalized",
              "op": "contains_any",
              "value": [
                "/kubepi/api/v1/sso"
              ]
            },
            {
              "all": [
                {
                  "field": "product",
                  "op": "eq",
                  "value": "nacos"
                },
                {
                  "field": "path_normalized",
                  "op": "contains_any",
                  "value": [
                    "/auth/",
                    "/users",
                    "/roles",
                    "/permissions"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "rationale": "HTTP成功不证明越权成功；还需要业务审计或响应内容核验。",
    "false_positives": "公开状态接口、返回200的登录页、错误的认证字段。",
    "status": "experimental"
  },
