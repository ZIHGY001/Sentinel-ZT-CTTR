[
  {
    "id": "B001",
    "title": "Office / 文档阅读器启动脚本解释器",
    "score": 55,
    "stage": "execution",
    "attack": [
      "T1204.002",
      "T1059"
    ],
    "condition": {
      "all": [
        {
          "field": "event_type",
          "op": "eq",
          "value": "process_start"
        },
        {
          "field": "parent_process_name",
          "op": "in",
          "value": [
            "winword.exe",
            "excel.exe",
            "powerpnt.exe",
            "outlook.exe",
            "acrord32.exe"
          ]
        },
        {
          "field": "process_name",
          "op": "in",
          "value": [
            "powershell.exe",
            "pwsh.exe",
            "cmd.exe",
            "wscript.exe",
            "cscript.exe",
            "mshta.exe",
            "bash",
            "sh",
            "dash",
            "python",
            "python3"
          ]
        }
      ]
    },
    "rationale": "文档进程与脚本解释器的父子关系构成执行线索。",
    "false_positives": "经批准的宏、报表导出和运维插件。",
    "status": "experimental"
  },
