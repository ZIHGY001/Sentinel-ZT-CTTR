  {
    "id": "B008",
    "title": "Jeecg 字典接口出现 SQL 语法线索",
    "score": 45,
    "stage": "initial_access",
    "attack": [
      "T1190"
    ],
    "condition": {
      "all": [
        {
          "field": "event_type",
          "op": "eq",
          "value": "http"
        },
        {
          "field": "path_normalized",
          "op": "contains_any",
          "value": [
            "/sys/dict/getdictitems/"
          ]
        },
        {
          "field": "query_normalized",
          "op": "contains_any",
          "value": [
            "filtersql"
          ]
        },
        {
          "field": "query_normalized",
          "op": "contains_any",
          "value": [
            "select ",
            "union ",
            "sleep(",
            "benchmark(",
            " or ",
            " and "
          ]
        }
      ]
    },
    "rationale": "参数中出现SQL语法只能证明可疑请求，不能证明注入成立。",
    "false_positives": "合法过滤查询、自测请求。",
    "status": "experimental"
  },
